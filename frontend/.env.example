# Copy to frontend/.env.local (git-ignored). Never put real values in this file.
# Dashboard login (plan R12): password now; GitHub OAuth later by env vars only.
AUTH_PROVIDERS=password
DASHBOARD_PASSWORD=at-least-16-random-characters
AUTH_SECRET=generate-with-backend-scripts-gen_keys
AUTH_TRUST_HOST=true
# Later, for GitHub login: AUTH_PROVIDERS=github (or password,github)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# ALLOWED_GITHUB_LOGINS=your-github-login

# Backend (server-side only; never NEXT_PUBLIC_*)
BACKEND_URL=http://localhost:8000
BACKEND_API_TOKEN=same-value-as-BACKEND_API_TOKENS-in-backend/.env
