# Copy to backend/.env for local development. Never commit .env.
# Generate secrets with:  uv run python scripts/gen_keys.py

# --- Database: local docker compose Postgres (Neon in production; any postgres:// URL works,
#     ?sslmode=require is translated for asyncpg automatically)
DATABASE_URL=postgresql://hubline:hubline@localhost:5433/hubline

# --- Server-to-server auth (Next.js server -> backend). Comma-separate to rotate.
BACKEND_API_TOKENS=change-me-run-scripts-gen_keys

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Background work (plan R3). Set to false to let Neon scale to zero.
ENABLE_SCHEDULER=true
ENABLE_AGENT_WORKER=true
SCHEDULER_IDLE_MAX_S=60
WORKER_IDLE_MAX_S=60

# --- Connectors
# DEMO_MODE=true only pre-enables the demo connector the FIRST time it is registered (local
# convenience). Production keeps the default (false) and toggles it from the Connectors page.
DEMO_MODE=true
# CONNECTORS_ENABLED=demo,slack,gmail   # optional allowlist; unset = all registered
BACKFILL_HOURS=48
BACKFILL_MAX=50

OWNER_TIMEZONE=Asia/Kolkata
