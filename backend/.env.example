# Copy to backend/.env for local development. Never commit .env. Everything here is free ($0).
# Generate secrets with:  uv run python scripts/gen_keys.py

# --- Database: local docker compose Postgres (Neon Free in production; any postgres:// URL works,
#     ?sslmode=require is translated for asyncpg automatically). For a Neon URL, copy the full
#     host from the console: it starts with ep-...
DATABASE_URL=postgresql://hubline:hubline@localhost:5433/hubline
# NEON_DEV_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Server-to-server auth (Next.js server -> backend). Comma-separate to rotate.
BACKEND_API_TOKENS=change-me-run-scripts-gen_keys

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Background work (plan R3/R9). Local: loops on, idle sleeps above Neon's 5-min suspend.
# Render Free (production): ENABLE_SCHEDULER=false, ENABLE_AGENT_WORKER=false,
# WORK_ON_DEMAND=true, TICK_ON_STARTUP=true, TICK_SECRET=<random>, called by the tick cron.
ENABLE_SCHEDULER=true
ENABLE_AGENT_WORKER=true
SCHEDULER_IDLE_MAX_S=600
WORKER_IDLE_MAX_S=600
WORK_ON_DEMAND=true
# TICK_SECRET=change-me-run-scripts-gen_keys
TICK_BUDGET_S=60
TICK_ON_STARTUP=false

# --- Connectors
# DEMO_MODE=true only pre-enables the demo connector the FIRST time it is registered (local
# convenience). Production keeps the default (false) and toggles it from the Connectors page.
DEMO_MODE=true
# CONNECTORS_ENABLED=demo,slack,gmail
BACKFILL_HOURS=48
BACKFILL_MAX=50
# store all backfill, auto-triage only the newest N per connector (rest: Triage on request)
BACKFILL_AUTO_TRIAGE=10

OWNER_TIMEZONE=Asia/Kolkata

# --- LLM (plan R7). "fake" = deterministic offline model (local dev + tests).
# Production: LLM_PROVIDER=groq (free tier) with GROQ_API_KEY.
# Gemini free tier: LLM_PROVIDER=google_genai, LLM_MODEL=gemini-3.5-flash-lite, GOOGLE_API_KEY
#   -> demo accounts only: Google may use free-tier prompts to improve its products.
LLM_PROVIDER=fake
LLM_MODEL=openai/gpt-oss-120b
LLM_EFFORT=low
# GROQ_API_KEY=gsk_...
# GOOGLE_API_KEY=AIza...
# Client-side pacing per model = Groq free limits for gpt-oss-120b (0 disables)
LLM_RPM=30
LLM_TPM=8000

# --- Agent worker (free-tier budgets; arithmetic in reports/step-2-report.md)
AGENT_CONCURRENCY=1
# burst shaping only; the 24h token budget + per-minute pacer are the real limits. 0 pauses.
AGENT_MAX_JOBS_PER_HOUR=30
# rolling 24h token budget (90% of Groq's 200K tokens/day); 0 disables
AGENT_MAX_TOKENS_PER_DAY=180000
AGENT_RETRY_DELAYS_S=30,120,600
AGENT_OWNER_NAME=Dhruv Sonkusare
AGENT_OWNER_CONTEXT=Python backend developer
AGENT_VIP_SENDERS=
